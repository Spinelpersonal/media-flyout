export global Palette {
    in-out property <bool> light: false;
    out property <color> surface: light ? #f5f6f9 : #1b1c24;
    out property <color> elevated: light ? #e7eaf0 : #252630;
    out property <color> hover: light ? #d8dfe6 : #32343f;
    out property <color> pressed: light ? #c6d2dc : #3c3e4a;
    out property <color> border: light ? #d0d5de : #383944;
    out property <color> text: light ? #202632 : #f4f3f7;
    out property <color> secondary: light ? #505b68 : #c1c0cb;
    out property <color> muted: light ? #677280 : #858593;
    in-out property <color> accent: #abb2b7;
    in-out property <color> on-accent: black;
    in-out property <color> accent-text: #abb2b7;
}

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> keyboard;
    out property <bool> hovered: touch.has-hover;
    out property <bool> pressed: touch.pressed;
    out property <bool> focused: keyboard && enabled && keys.has-focus;
    callback clicked;
    accessible-role: button;
    accessible-label: label;
    accessible-enabled: enabled;
    accessible-action-default => { if enabled { root.clicked(); } }
    keys := FocusScope {
        enabled: root.enabled && root.keyboard;
        key-pressed(event) => {
            if self.enabled && (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
    border-width: focused ? 2px : 0px;
    border-color: Palette.text;
}

component TransportButton inherits ActionButton {
    in property <string> glyph;
    in property <bool> primary: false;
    width: primary ? 44px : 36px;
    height: primary ? 44px : 36px;
    border-radius: 22px;
    background: !self.enabled ? Palette.elevated : primary ? Palette.accent : (self.pressed ? Palette.pressed : self.hovered ? Palette.hover : transparent);
    border-width: self.focused ? 3px : self.enabled && primary ? (self.pressed ? 3px : 1px) : 0px;
    border-color: self.focused ? (primary ? Palette.on-accent : Palette.text) : self.hovered || self.pressed ? Palette.on-accent : Palette.accent-text;
    Text {
        text: root.glyph;
        font-family: "Segoe MDL2 Assets";
        font-size: root.primary ? 18px : 17px;
        color: !root.enabled ? Palette.muted : root.primary ? Palette.on-accent : Palette.accent-text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component PlaybackModeButton inherits ActionButton {
    in property <string> glyph;
    in property <bool> active;
    width: 26px;
    height: 26px;
    border-radius: 13px;
    background: active ? Palette.accent : self.pressed ? Palette.pressed : self.hovered ? Palette.hover : transparent;
    border-color: active ? Palette.on-accent : Palette.text;
    accessible-checkable: true;
    accessible-checked: active;
    Text {
        text: root.glyph;
        font-family: "Segoe MDL2 Assets";
        font-size: 14px;
        color: root.active ? Palette.on-accent : Palette.accent-text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export enum RepeatState { unavailable, off, all, one }

export component Flyout inherits Window {
    title: "Media Flyout";
    width: 452px;
    height: lyrics-open ? 340px : 196px;
    no-frame: true;
    background: Palette.surface;
    default-font-family: "Segoe UI";
    in property <string> track-title: "Nothing playing";
    in property <string> artist: "Open a media player to get started";
    in property <string> album;
    in property <string> source: "MEDIA FLYOUT";
    in property <string> status;
    in property <bool> lyrics-open;
    in property <bool> lyrics-available;
    in property <bool> lyrics-timed;
    in property <string> lyrics-body;
    in property <string> lyric-before;
    in property <string> lyric-word;
    in property <string> lyric-after;
    in property <string> lyric-next;
    callback toggle-lyrics;
    callback lyrics-ready;
    in property <image> artwork;
    in property <[int]> spectrum;
    callback spectrum-updated;
    in property <bool> has-artwork;
    in property <bool> playing;
    in property <bool> can-toggle;
    in property <bool> can-previous;
    in property <bool> can-next;
    in property <bool> can-shuffle;
    in property <bool> shuffling;
    in property <RepeatState> repeat-mode;
    private property <bool> has-playback-modes: can-shuffle || repeat-mode != RepeatState.unavailable;
    callback toggle-shuffle;
    callback cycle-repeat;
    in property <bool> has-timeline;
    in property <bool> can-seek;
    in property <bool> volume-available;
    in property <int> app-volume;
    in property <bool> app-muted;
    in-out property <bool> adjusting-volume;
    private property <int> volume-preview;
    private property <int> displayed-volume: adjusting-volume ? volume-preview : app-volume;
    callback volume-updated;
    callback set-volume(int);
    callback step-volume(int);
    callback toggle-mute;
    callback volume-interaction;
    in-out property <bool> seeking: false;
    in property <float> progress;
    in property <string> elapsed;
    in property <string> duration;
    in property <[string]> session-labels;
    in property <int> selected-session: 0;
    in-out property <bool> session-menu: false;
    in property <bool> pinned;
    callback toggle-pin;
    in property <bool> keyboard-mode;
    private property <int> menu-row;
    private property <int> active-row: max(0, min(menu-row, session-labels.length - 1));
    public function focus-source() { source-keys.focus(); }
    public function outside-click() { if !pinned { dismiss(); } }
    public function escape() {
        if session-menu && !pinned {
            session-menu = false;
            if keyboard-mode { focus-source(); }
        } else { dismiss(); }
    }
    function toggle-menu() {
        menu-row = selected-session;
        session-menu = !session-menu;
        if keyboard-mode { focus-source(); }
    }
    callback toggle-playback;
    callback previous;
    callback next;
    callback dismiss;
    callback media-updated;
    callback select-session(int);
    callback seek-started;
    callback seek-preview(float);
    callback seek-committed;
    callback seek-cancelled;
    callback step-seek(int);

    Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        border-radius: 16px;
        border-width: 1px;
        border-color: Palette.border;
        background: Palette.surface;

        Rectangle {
            x: 20px; y: 20px; width: 106px; height: 106px;
            border-radius: 10px;
            clip: true;
            background: #2a3038;
            if root.has-artwork: Image { source: root.artwork; image-fit: cover; width: 100%; height: 100%; }
            if !root.has-artwork: Text {
                text: "\u{e8d6}";
                font-family: "Segoe MDL2 Assets";
                font-size: 36px;
                color: #a1a7ab;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            x: 146px; y: 20px; width: root.lyrics-available || root.lyrics-open ? 166px : 224px; height: 15px;
            text: root.source; color: Palette.accent-text; font-size: 10px; font-weight: 600;
            overflow: elide; wrap: no-wrap;
        }
        Text {
            x: 146px; y: 43px; width: 286px; height: 26px;
            text: root.track-title; color: Palette.text; font-size: 19px; font-weight: 600;
            overflow: elide; wrap: no-wrap;
        }
        Text {
            x: 146px; y: 75px; width: 286px; height: 20px;
            text: root.artist; color: Palette.secondary; font-size: 13px;
            overflow: elide; wrap: no-wrap;
        }
        Text {
            x: 146px; y: 95px; width: 286px; height: 15px;
            text: root.album; color: Palette.muted; font-size: 11px;
            overflow: elide; wrap: no-wrap;
        }
        Text {
            x: 146px; y: 110px; width: 66px; height: 22px;
            text: "App volume"; font-size: 11px; color: Palette.secondary; vertical-alignment: center;
        }
        ActionButton {
            x: 212px; y: 110px; width: 24px; height: 22px; border-radius: 4px;
            enabled: root.volume-available && !root.session-menu;
            keyboard: root.keyboard-mode;
            label: root.app-muted ? "Unmute application" : "Mute application";
            background: self.hovered && self.enabled ? Palette.hover : transparent;
            Text {
                text: root.app-muted ? "\u{e74f}" : "\u{e767}";
                font-family: "Segoe MDL2 Assets"; font-size: 14px;
                color: root.volume-available ? Palette.accent-text : Palette.muted;
                horizontal-alignment: center; vertical-alignment: center;
            }
            clicked => { root.toggle-mute(); }
        }
        Rectangle {
            x: 240px; y: 110px; width: 146px; height: 22px; border-radius: 4px;
            background: transparent;
            border-color: Palette.text;
            border-width: volume-keys.enabled && volume-keys.has-focus ? 2px : 0px;
            accessible-role: slider;
            accessible-label: "Application volume";
            accessible-enabled: root.volume-available;
            accessible-value: root.volume-available ? "\{root.displayed-volume}%" : "Unavailable";
            accessible-action-increment => { if root.volume-available { root.step-volume(5); } }
            accessible-action-decrement => { if root.volume-available { root.step-volume(-5); } }
            volume-keys := FocusScope {
                enabled: root.keyboard-mode && root.volume-available && !root.session-menu;
                key-pressed(event) => {
                    if self.enabled && (event.text == Key.LeftArrow || event.text == Key.RightArrow) {
                        root.step-volume(event.text == Key.LeftArrow ? -5 : 5);
                        return accept;
                    }
                    return reject;
                }
            }
            Rectangle {
                x: 5px; y: 10px; width: parent.width - 10px; height: 3px; border-radius: 2px;
                background: Palette.border;
                if root.volume-available: Rectangle {
                    x: 0px; y: 0px; height: parent.height; width: parent.width * root.displayed-volume / 100;
                    background: root.app-muted ? Palette.muted : Palette.accent-text; border-radius: 2px;
                }
                if root.volume-available: Rectangle {
                    x: parent.width * root.displayed-volume / 100 - 4px; y: -3px;
                    height: 9px; width: 9px; border-radius: 5px; background: Palette.accent-text;
                }
            }
            TouchArea {
                enabled: root.volume-available && !root.session-menu;
                mouse-cursor: pointer;
                function preview() {
                    root.volume-preview = round(100 * max(0, min(1, (self.mouse-x - 5px) / (self.width - 10px))));
                }
                pointer-event(event) => {
                    if event.kind == PointerEventKind.cancel {
                        root.adjusting-volume = false;
                        root.volume-interaction();
                    } else if event.button == PointerEventButton.left {
                        if event.kind == PointerEventKind.down {
                            preview(); root.adjusting-volume = true; root.volume-interaction();
                        } else if event.kind == PointerEventKind.up && root.adjusting-volume {
                            preview(); root.adjusting-volume = false; root.set-volume(root.volume-preview);
                        }
                    }
                }
                moved => { if root.adjusting-volume { preview(); } }
            }
        }
        Text {
            x: 391px; y: 110px; width: 41px; height: 22px;
            text: root.volume-available ? "\{root.displayed-volume}%" : "—";
            font-size: 11px; color: Palette.muted; vertical-alignment: center;
            horizontal-alignment: right;
        }
        HorizontalLayout {
            x: root.has-playback-modes ? 122px : 146px;
            y: 131px;
            width: root.has-playback-modes ? 178px : 142px;
            height: 44px;
            spacing: root.has-playback-modes ? 2px : 10px;
            alignment: center;
            if root.can-shuffle: PlaybackModeButton {
                keyboard: root.keyboard-mode;
                glyph: "\u{e8b1}";
                label: "Shuffle";
                active: root.shuffling;
                clicked => { root.toggle-shuffle(); }
            }
            TransportButton { keyboard: root.keyboard-mode; glyph: "\u{e892}"; label: "Previous track"; enabled: root.can-previous; clicked => { root.previous(); } }
            TransportButton { keyboard: root.keyboard-mode; glyph: root.playing ? "\u{e769}" : "\u{e768}"; label: root.playing ? "Pause" : "Play"; primary: true; enabled: root.can-toggle; clicked => { root.toggle-playback(); } }
            TransportButton { keyboard: root.keyboard-mode; glyph: "\u{e893}"; label: "Next track"; enabled: root.can-next; clicked => { root.next(); } }
            if root.repeat-mode != RepeatState.unavailable: PlaybackModeButton {
                keyboard: root.keyboard-mode;
                glyph: root.repeat-mode == RepeatState.one ? "\u{e8ed}" : "\u{e8ee}";
                label: root.repeat-mode == RepeatState.one ? "Repeat one" : root.repeat-mode == RepeatState.all ? "Repeat all" : "Repeat off";
                active: root.repeat-mode != RepeatState.off;
                clicked => { root.cycle-repeat(); }
            }
        }
        Text {
            x: 20px; y: 143px; width: 106px; height: 16px;
            text: root.playing ? "PLAYING" : root.can-toggle ? "PAUSED" : "READY";
            color: Palette.muted; font-size: 9px; horizontal-alignment: center;
        }
        for level[index] in root.spectrum: Rectangle {
            x: 25px + index * 4px; y: 178px - self.height;
            width: 3px; height: level * 1px; border-radius: 1px;
            background: Palette.accent-text;
        }
        ActionButton {
            x: parent.width - 58px; y: 12px; width: 24px; height: 22px;
            keyboard: root.keyboard-mode;
            label: root.pinned ? "Unpin flyout" : "Pin flyout";
            accessible-checkable: true;
            accessible-checked: root.pinned;
            border-radius: 5px;
            background: root.pinned ? Palette.accent : self.pressed ? Palette.pressed : self.hovered ? Palette.hover : transparent;
            Text {
                text: root.pinned ? "\u{e77a}" : "\u{e718}";
                font-family: "Segoe MDL2 Assets"; font-size: 13px;
                color: root.pinned ? Palette.on-accent : Palette.secondary;
                horizontal-alignment: center; vertical-alignment: center;
            }
            clicked => { root.toggle-pin(); }
        }
        ActionButton {
            x: parent.width - 32px; y: 12px; width: 20px; height: 20px;
            keyboard: root.keyboard-mode;
            label: "Close";
            border-radius: 5px;
            background: self.hovered ? Palette.hover : transparent;
            Text { text: "\u{e711}"; font-family: "Segoe MDL2 Assets"; font-size: 9px; color: Palette.muted; horizontal-alignment: center; vertical-alignment: center; }
            clicked => { root.dismiss(); }
        }
        if root.status != "": Text {
            x: root.has-timeline ? 20px : 302px;
            y: root.has-timeline ? 178px : 134px;
            width: root.has-timeline ? 412px : 130px;
            height: root.has-timeline ? 14px : 40px;
            text: root.status; color: #dcbb8a; font-size: 10px; wrap: word-wrap;
            overflow: elide;
        }
        if root.has-timeline: Rectangle {
            x: 304px; y: 142px; width: 128px; height: 36px;
            background: transparent;
            Text { x: 0px; y: 0px; width: parent.width / 2; height: 14px; text: root.elapsed; font-size: 10px; color: Palette.muted; horizontal-alignment: left; }
            Text { x: parent.width / 2; y: 0px; width: parent.width / 2; height: 14px; text: root.duration; font-size: 10px; color: Palette.muted; horizontal-alignment: right; }
            Rectangle {
                x: 0px; y: 16px; height: 20px; width: parent.width;
                background: transparent;
                border-radius: 4px;
                border-color: Palette.text;
                border-width: seek-keys.enabled && seek-keys.has-focus ? 2px : 0px;
                seek-keys := FocusScope {
                    enabled: root.keyboard-mode && root.can-seek;
                    key-pressed(event) => {
                        if self.enabled && (event.text == Key.LeftArrow || event.text == Key.RightArrow) {
                            root.step-seek(event.text == Key.LeftArrow ? -5 : 5);
                            return accept;
                        }
                        return reject;
                    }
                }
                Rectangle {
                    x: 0px; y: (parent.height - self.height) / 2;
                    height: root.can-seek && (seek-touch.has-hover || root.seeking) ? 4px : 2px;
                    width: parent.width; border-radius: 2px; background: Palette.border;
                    Rectangle { x: 0px; y: 0px; height: parent.height; width: parent.width * root.progress; border-radius: 2px; background: Palette.accent-text; }
                }
                if root.can-seek && (seek-touch.has-hover || root.seeking): Rectangle {
                    x: max(0px, min(parent.width - self.width, parent.width * root.progress - self.width / 2));
                    y: (parent.height - self.height) / 2;
                    width: 10px; height: 10px; border-radius: 5px;
                    background: Palette.accent-text;
                }
                seek-touch := TouchArea {
                    enabled: root.can-seek;
                    mouse-cursor: pointer;
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.cancel {
                            if root.seeking { root.seek-cancelled(); }
                        } else if event.button == PointerEventButton.left {
                            if event.kind == PointerEventKind.down {
                                root.seeking = true;
                                root.seek-started();
                                root.seek-preview(max(0, min(1, self.mouse-x / self.width)));
                            } else if event.kind == PointerEventKind.up && root.seeking {
                                root.seek-preview(max(0, min(1, self.mouse-x / self.width)));
                                root.seek-committed();
                            }
                        }
                    }
                    moved => {
                        if root.seeking { root.seek-preview(max(0, min(1, self.mouse-x / self.width))); }
                    }
                }
            }
        }

        Rectangle {
            x: 140px; y: 12px; width: root.lyrics-available || root.lyrics-open ? 190px : 254px; height: 28px;
            background: transparent;
            border-radius: 5px;
            border-width: root.keyboard-mode && source-keys.has-focus && !root.session-menu ? 2px : 0px;
            border-color: Palette.text;
            accessible-role: button;
            accessible-label: "Select media session";
            accessible-action-default => { root.toggle-menu(); }
            source-keys := FocusScope {
                enabled: root.keyboard-mode;
                key-pressed(event) => {
                    if event.text == Key.Return || event.text == " " {
                        if root.session-menu {
                            root.session-menu = false;
                            root.select-session(root.active-row);
                        } else { root.toggle-menu(); }
                        return accept;
                    }
                    if event.text == Key.UpArrow || event.text == Key.DownArrow
                        || (root.session-menu && (event.text == Key.Tab || event.text == Key.Backtab)) {
                        if !root.session-menu { root.toggle-menu(); }
                        else {
                            root.menu-row = max(0, min(root.session-labels.length - 1,
                                root.active-row + (event.text == Key.UpArrow || event.text == Key.Backtab ? -1 : 1)));
                        }
                        return accept;
                    }
                    return reject;
                }
            }
            Text { x: parent.width - 14px; width: 12px; text: "\u{e70d}"; font-family: "Segoe MDL2 Assets"; font-size: 9px; color: Palette.accent-text; vertical-alignment: center; }
            TouchArea { clicked => { root.toggle-menu(); } }
        }
        if root.lyrics-available || root.lyrics-open: ActionButton {
            x: 338px; y: 13px; width: 52px; height: 24px;
            border-radius: 5px;
            keyboard: root.keyboard-mode;
            background: self.hovered || root.lyrics-open ? Palette.elevated : transparent;
            label: root.lyrics-open ? "Hide lyrics" : "Show lyrics";
            clicked => { root.toggle-lyrics(); }
            Text { text: "Lyrics"; color: Palette.accent-text; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
        }
        if root.lyrics-open: Rectangle {
            x: 20px; y: 195px; width: parent.width - 40px; height: parent.height - self.y - 14px;
            background: transparent;
            clip: true;
            if root.lyrics-timed: VerticalLayout {
                y: 10px; height: parent.height - 16px; width: parent.width;
                spacing: 6px; alignment: center;
                StyledText {
                    text: @markdown("\{root.lyric-before}**\{root.lyric-word}**\{root.lyric-after}");
                    default-color: Palette.text; default-font-size: 18px;
                    max-lines: 3;
                }
                Text { text: root.lyric-next; color: Palette.secondary; font-size: 13px; wrap: word-wrap; max-lines: 2; overflow: elide; }
            }
            if !root.lyrics-timed: Flickable {
                y: 10px; height: parent.height - 12px; width: parent.width;
                content-width: self.width; content-height: max(self.height, copy.preferred-height);
                property <string> body: root.lyrics-body;
                changed body => { self.content-y = 0px; }
                copy := Text {
                    width: parent.width; height: self.preferred-height;
                    text: root.lyrics-body; color: Palette.secondary; font-size: 14px; wrap: word-wrap;
                }
            }
        }
        if root.session-menu: Rectangle {
            x: 12px; y: 40px; width: parent.width - 24px; height: 144px;
            border-radius: 10px; border-width: 1px; border-color: Palette.border;
            background: Palette.elevated;
            clip: true;
            Flickable {
                x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
                content-height: root.session-labels.length * 34px;
                content-width: self.width;
                property <length> row-top: root.active-row * 34px;
                function reveal-row() {
                    if root.keyboard-mode {
                        self.content-y = min(0px, max(-row-top, min(self.content-y, self.height - row-top - 34px)));
                    }
                }
                init => { reveal-row(); }
                changed row-top => { reveal-row(); }
                for label[index] in root.session-labels: Rectangle {
                    x: 0px; y: index * 34px; width: parent.width; height: 34px;
                    border-radius: 6px;
                    border-width: root.keyboard-mode && index == root.active-row ? 2px : 0px;
                    border-color: Palette.text;
                    background: row-touch.has-hover ? Palette.hover : index == root.selected-session ? Palette.pressed : transparent;
                    Text { x: 12px; width: parent.width - 24px; text: label; font-size: 12px; color: index == root.selected-session ? Palette.accent-text : Palette.text; vertical-alignment: center; overflow: elide; wrap: no-wrap; }
                    row-touch := TouchArea { clicked => { root.session-menu = false; root.select-session(index); } }
                }
            }
        }
    }
}

export component TrackNotification inherits Window {
    title: "Now playing";
    width: 328px;
    height: 78px;
    no-frame: true;
    background: Palette.surface;
    default-font-family: "Segoe UI";
    in property <string> track-title;
    in property <string> artist;
    in property <string> player;
    in property <image> artwork;
    in property <bool> has-artwork;

    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: 16px;
        border-width: 1px;
        border-color: Palette.border;
        background: Palette.surface;

        Rectangle {
            x: 12px;
            y: 12px;
            width: 54px;
            height: 54px;
            border-radius: 9px;
            background: Palette.elevated;
            clip: true;
            if root.has-artwork : Image {
                source: root.artwork;
                width: parent.width;
                height: parent.height;
                image-fit: cover;
            }
            if !root.has-artwork : Text {
                text: "♪";
                color: Palette.accent-text;
                font-size: 25px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        VerticalLayout {
            x: 78px;
            width: parent.width - 90px;
            y: 9px;
            height: parent.height - 18px;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.player;
                color: Palette.secondary;
                font-size: 11px;
                overflow: elide;
            }
            Text {
                text: root.track-title;
                color: Palette.text;
                font-size: 15px;
                font-weight: 650;
                overflow: elide;
            }
            if root.artist != "" : Text {
                text: root.artist;
                color: Palette.secondary;
                font-size: 12px;
                overflow: elide;
            }
        }
    }
}
