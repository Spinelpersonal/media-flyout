export global Palette {
    in-out property <bool> light: false;
    out property <color> surface: light ? #f5f6f9 : #1b1c24;
    out property <color> elevated: light ? #e7eaf0 : #252630;
    out property <color> hover: light ? #d8dfe6 : #32343f;
    out property <color> pressed: light ? #c6d2dc : #3c3e4a;
    out property <color> border: light ? #d0d5de : #383944;
    out property <color> text: light ? #202632 : #f4f3f7;
    out property <color> secondary: light ? #505b68 : #c1c0cb;
    out property <color> muted: light ? #677280 : #858593;
    out property <color> accent-text: light ? #286451 : #91b9aa;
}

component TransportButton inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> primary: false;
    callback clicked;
    width: primary ? 44px : 36px;
    height: primary ? 44px : 36px;
    border-radius: 22px;
    background: !enabled ? Palette.elevated : primary ? (touch.pressed ? #8bbdb0 : touch.has-hover ? #c7ecde : #ade0cd) : (touch.pressed ? Palette.pressed : touch.has-hover ? Palette.hover : transparent);
    accessible-role: button;
    accessible-label: label;
    accessible-enabled: enabled;
    accessible-action-default => { if enabled { root.clicked(); } }
    Text {
        text: root.glyph;
        font-family: "Segoe MDL2 Assets";
        font-size: root.primary ? 18px : 17px;
        color: !root.enabled ? Palette.muted : root.primary ? #142a24 : Palette.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

export component Flyout inherits Window {
    title: "Media Flyout";
    width: 452px;
    height: 196px;
    no-frame: true;
    background: Palette.surface;
    default-font-family: "Segoe UI";
    in property <string> track-title: "Nothing playing";
    in property <string> artist: "Open a media player to get started";
    in property <string> album;
    in property <string> source: "MEDIA FLYOUT";
    in property <string> status;
    in property <image> artwork;
    in property <bool> has-artwork;
    in property <bool> playing;
    in property <bool> can-toggle;
    in property <bool> can-previous;
    in property <bool> can-next;
    in property <bool> has-timeline;
    in property <bool> can-seek;
    in-out property <bool> seeking: false;
    in property <float> progress;
    in property <string> elapsed;
    in property <string> duration;
    in property <[string]> session-labels;
    in property <int> selected-session: 0;
    in-out property <bool> session-menu: false;
    callback toggle-playback;
    callback previous;
    callback next;
    callback dismiss;
    callback media-updated;
    callback select-session(int);
    callback seek-started;
    callback seek-preview(float);
    callback seek-committed;
    callback seek-cancelled;

    FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape { root.dismiss(); return accept; }
            return reject;
        }
    }

    Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        border-radius: 16px;
        border-width: 1px;
        border-color: Palette.border;
        background: Palette.surface;

        Rectangle {
            x: 20px; y: 20px; width: 106px; height: 106px;
            border-radius: 10px;
            clip: true;
            background: #2a3038;
            if root.has-artwork: Image { source: root.artwork; image-fit: cover; width: 100%; height: 100%; }
            if !root.has-artwork: Text {
                text: "\u{e8d6}";
                font-family: "Segoe MDL2 Assets";
                font-size: 36px;
                color: #8ba99f;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            x: 146px; y: 20px; width: 224px; height: 15px;
            text: root.source; color: Palette.accent-text; font-size: 10px; font-weight: 600;
            overflow: elide; wrap: no-wrap;
        }
        Text {
            x: 146px; y: 43px; width: 286px; height: 26px;
            text: root.track-title; color: Palette.text; font-size: 19px; font-weight: 600;
            overflow: elide; wrap: no-wrap;
        }
        Text {
            x: 146px; y: 75px; width: 286px; height: 20px;
            text: root.artist; color: Palette.secondary; font-size: 13px;
            overflow: elide; wrap: no-wrap;
        }
        Text {
            x: 146px; y: 100px; width: 286px; height: 18px;
            text: root.album; color: Palette.muted; font-size: 11px;
            overflow: elide; wrap: no-wrap;
        }
        HorizontalLayout {
            x: 146px; y: 131px; width: 142px; height: 44px;
            spacing: 10px;
            alignment: center;
            TransportButton { glyph: "\u{e892}"; label: "Previous track"; enabled: root.can-previous; clicked => { root.previous(); } }
            TransportButton { glyph: root.playing ? "\u{e769}" : "\u{e768}"; label: root.playing ? "Pause" : "Play"; primary: true; enabled: root.can-toggle; clicked => { root.toggle-playback(); } }
            TransportButton { glyph: "\u{e893}"; label: "Next track"; enabled: root.can-next; clicked => { root.next(); } }
        }
        Text {
            x: 20px; y: 143px; width: 106px; height: 16px;
            text: root.playing ? "PLAYING" : root.can-toggle ? "PAUSED" : "READY";
            color: Palette.muted; font-size: 9px; horizontal-alignment: center;
        }
        Rectangle {
            x: parent.width - 32px; y: 12px; width: 20px; height: 20px;
            border-radius: 5px;
            background: close-touch.has-hover ? Palette.hover : transparent;
            Text { text: "\u{e711}"; font-family: "Segoe MDL2 Assets"; font-size: 9px; color: Palette.muted; horizontal-alignment: center; vertical-alignment: center; }
            close-touch := TouchArea { clicked => { root.dismiss(); } }
        }
        if root.status != "": Text {
            x: root.has-timeline ? 20px : 302px;
            y: root.has-timeline ? 178px : 134px;
            width: root.has-timeline ? 412px : 130px;
            height: root.has-timeline ? 14px : 40px;
            text: root.status; color: #dcbb8a; font-size: 10px; wrap: word-wrap;
            overflow: elide;
        }
        if root.has-timeline: Rectangle {
            x: 304px; y: 142px; width: 128px; height: 36px;
            background: transparent;
            Text { x: 0px; y: 0px; width: parent.width / 2; height: 14px; text: root.elapsed; font-size: 10px; color: Palette.muted; horizontal-alignment: left; }
            Text { x: parent.width / 2; y: 0px; width: parent.width / 2; height: 14px; text: root.duration; font-size: 10px; color: Palette.muted; horizontal-alignment: right; }
            Rectangle {
                x: 0px; y: 16px; height: 20px; width: parent.width;
                background: transparent;
                Rectangle {
                    x: 0px; y: (parent.height - self.height) / 2;
                    height: root.can-seek && (seek-touch.has-hover || root.seeking) ? 4px : 2px;
                    width: parent.width; border-radius: 2px; background: Palette.border;
                    Rectangle { x: 0px; y: 0px; height: parent.height; width: parent.width * root.progress; border-radius: 2px; background: Palette.accent-text; }
                }
                if root.can-seek && (seek-touch.has-hover || root.seeking): Rectangle {
                    x: max(0px, min(parent.width - self.width, parent.width * root.progress - self.width / 2));
                    y: (parent.height - self.height) / 2;
                    width: 10px; height: 10px; border-radius: 5px;
                    background: Palette.accent-text;
                }
                seek-touch := TouchArea {
                    enabled: root.can-seek;
                    mouse-cursor: pointer;
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.cancel {
                            if root.seeking { root.seek-cancelled(); }
                        } else if event.button == PointerEventButton.left {
                            if event.kind == PointerEventKind.down {
                                root.seeking = true;
                                root.seek-started();
                                root.seek-preview(max(0, min(1, self.mouse-x / self.width)));
                            } else if event.kind == PointerEventKind.up && root.seeking {
                                root.seek-preview(max(0, min(1, self.mouse-x / self.width)));
                                root.seek-committed();
                            }
                        }
                    }
                    moved => {
                        if root.seeking { root.seek-preview(max(0, min(1, self.mouse-x / self.width))); }
                    }
                }
            }
        }

        Rectangle {
            x: 140px; y: 12px; width: 254px; height: 28px;
            background: transparent;
            Text { x: parent.width - 14px; width: 12px; text: "\u{e70d}"; font-family: "Segoe MDL2 Assets"; font-size: 9px; color: Palette.muted; vertical-alignment: center; }
            TouchArea { clicked => { root.session-menu = !root.session-menu; } }
        }
        if root.session-menu: Rectangle {
            x: 12px; y: 40px; width: parent.width - 24px; height: 144px;
            border-radius: 10px; border-width: 1px; border-color: Palette.border;
            background: Palette.elevated;
            clip: true;
            Flickable {
                x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
                content-height: root.session-labels.length * 34px;
                content-width: self.width;
                for label[index] in root.session-labels: Rectangle {
                    x: 0px; y: index * 34px; width: parent.width; height: 34px;
                    border-radius: 6px;
                    background: row-touch.has-hover ? Palette.hover : index == root.selected-session ? Palette.pressed : transparent;
                    Text { x: 12px; width: parent.width - 24px; text: label; font-size: 12px; color: Palette.text; vertical-alignment: center; overflow: elide; wrap: no-wrap; }
                    row-touch := TouchArea { clicked => { root.session-menu = false; root.select-session(index); } }
                }
            }
        }
    }
}
